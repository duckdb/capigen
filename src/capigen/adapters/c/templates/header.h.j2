{{ c_opts.banner }}

#pragma once

#include <stdbool.h>
#include <stdint.h>
#include <stddef.h>

#ifdef __cplusplus
extern "C" {
#endif

#ifndef {{ c_opts.export_macro }}
#ifdef _WIN32
  #ifdef DUCKDB_STATIC_BUILD
    #define {{ c_opts.export_macro }}
  #elif defined(DUCKDB_BUILD_LIBRARY) && !defined(DUCKDB_BUILD_LOADABLE_EXTENSION)
    #define {{ c_opts.export_macro }} __declspec(dllexport)
  #else
    #define {{ c_opts.export_macro }} __declspec(dllimport)
  #endif
#else
  #if defined(__GNUC__) || defined(__clang__)
    #define {{ c_opts.export_macro }} __attribute__((visibility("default")))
  #else
    #define {{ c_opts.export_macro }}
  #endif
#endif
#endif

#ifndef {{ c_opts.extension_export_macro }}
#ifdef _WIN32
  #ifdef DUCKDB_STATIC_BUILD
    #define {{ c_opts.extension_export_macro }}
  #else
    #define {{ c_opts.extension_export_macro }} __declspec(dllexport)
  #endif
#else
  #if defined(__GNUC__) || defined(__clang__)
    #define {{ c_opts.extension_export_macro }} __attribute__((visibility("default")))
  #else
    #define {{ c_opts.extension_export_macro }}
  #endif
#endif
#endif

#if defined(__GNUC__) || defined(__clang__)
  #define {{ c_opts.deprecated_macro }} __attribute__((deprecated("This function is deprecated and will be removed in a future version.")))
#elif defined(_MSC_VER)
  #define {{ c_opts.deprecated_macro }} __declspec(deprecated("This function is deprecated and will be removed in a future version."))
#else
  #define {{ c_opts.deprecated_macro }}
#endif

{% set v = c_opts.version_macro %}
//===--------------------------------------------------------------------===//
// API version
//===--------------------------------------------------------------------===//
//! The API version this translation unit targets. Define all three to compile against an
//! older surface than the one this header describes.
#if !defined({{ v }}_MAJOR) && !defined({{ v }}_MINOR) && !defined({{ v }}_PATCH)
#define {{ v }}_MAJOR {{ c_opts.default_version[0] }}
#define {{ v }}_MINOR {{ c_opts.default_version[1] }}
#define {{ v }}_PATCH {{ c_opts.default_version[2] }}
#elif !(defined({{ v }}_MAJOR) && defined({{ v }}_MINOR) && defined({{ v }}_PATCH))
#error "define all or none of the {{ v }}_MAJOR / _MINOR / _PATCH macros"
#endif

//! True when the targeted version is x.y.z or newer.
#define {{ v }}_AT_LEAST(x, y, z) ({{ v }}_MAJOR > (x) || ({{ v }}_MAJOR == (x) && ({{ v }}_MINOR > (y) || ({{ v }}_MINOR == (y) && {{ v }}_PATCH >= (z)))))

//! True when the targeted version is older than x.y.z.
#define {{ v }}_BELOW(x, y, z) (!{{ v }}_AT_LEAST((x), (y), (z)))

{% if c_opts.gated_states %}
//===--------------------------------------------------------------------===//
// Surface switches
//===--------------------------------------------------------------------===//
{% for g in c_opts.gated_states %}
//! Set to 1 to compile the {{ g.name }} surface, 0 to omit it. Defaults from the
//! older {{ g.guard }} macro when that is what the consumer defines.
#if !defined({{ g.allow }})
#ifdef {{ g.guard }}
#define {{ g.allow }} {{ g.legacy }}
#else
#define {{ g.allow }} {{ g.default }}
#endif
#endif

{% endfor %}
{% for g in c_opts.gated_states if g.default == "0" %}
//! The {{ g.name }} surface is not a promise, so it is not part of any released
//! version: its constructs may change shape or vanish. Targeting an older version
//! while opting into it would hand back today's shapes under names that version
//! never promised, so the two are mutually exclusive.
#if {{ g.allow }} && !{{ v }}_AT_LEAST({{ c_opts.default_version[0] }}, {{ c_opts.default_version[1] }}, {{ c_opts.default_version[2] }})
#error "the {{ g.name }} surface requires targeting the newest API version"
#endif

{% endfor %}
{% endif %}
//===--------------------------------------------------------------------===//
// General type definitions
//===--------------------------------------------------------------------===//

{% if c_opts.emit_v1_primitive_defs %}
//! The internal representation of a VARCHAR (string_t). If the VARCHAR does not
//! exceed 12 characters, then we inline it. Otherwise, we inline a four-byte prefix for faster
//! string comparisons and store a pointer to the remaining characters. This is a non-
//! owning structure, i.e., it does not have to be freed.
typedef struct {
	union {
		struct {
			uint32_t length;
			char prefix[4];
			char *ptr;
		} pointer;
		struct {
			uint32_t length;
			char inlined[12];
		} inlined;
	} value;
} duckdb_string_t;

//! The returned state of different functions. Legacy naming: values use DuckDB prefix without underscore.
typedef enum duckdb_state {
  DuckDBSuccess = 0,
  DuckDBError = 1
} duckdb_state;

struct ArrowSchema;
struct ArrowArray;

{% endif %}

{% if c_opts.emit_arrow_defs %}
// Arrow C Data Interface (https://arrow.apache.org/docs/format/CDataInterface.html).
// Defined here so this header is self-contained: a binding author can allocate
// and fill an ArrowSchema / ArrowArray with only this header. Guarded by the
// standard ARROW_C_DATA_INTERFACE / ARROW_C_STREAM_INTERFACE macros that
// pyarrow / nanoarrow / arrow also use, so these definitions coexist with a
// consumer's own Arrow headers (first definition wins; the layouts are
// byte-identical by spec).
#ifndef ARROW_C_DATA_INTERFACE
#define ARROW_C_DATA_INTERFACE

#define ARROW_FLAG_DICTIONARY_ORDERED 1
#define ARROW_FLAG_NULLABLE 2
#define ARROW_FLAG_MAP_KEYS_SORTED 4

struct ArrowSchema {
	const char *format;
	const char *name;
	const char *metadata;
	int64_t flags;
	int64_t n_children;
	struct ArrowSchema **children;
	struct ArrowSchema *dictionary;
	void (*release)(struct ArrowSchema *);
	void *private_data;
};

struct ArrowArray {
	int64_t length;
	int64_t null_count;
	int64_t offset;
	int64_t n_buffers;
	int64_t n_children;
	const void **buffers;
	struct ArrowArray **children;
	struct ArrowArray *dictionary;
	void (*release)(struct ArrowArray *);
	void *private_data;
};

#endif

#ifndef ARROW_C_STREAM_INTERFACE
#define ARROW_C_STREAM_INTERFACE

struct ArrowArrayStream {
	int (*get_schema)(struct ArrowArrayStream *, struct ArrowSchema *out);
	int (*get_next)(struct ArrowArrayStream *, struct ArrowArray *out);
	const char *(*get_last_error)(struct ArrowArrayStream *);
	void (*release)(struct ArrowArrayStream *);
	void *private_data;
};

#endif

{% endif %}

{% for p in primitives if p.get('underlying') %}
typedef {{ p.underlying }} {{ p.c_type }};
{% endfor %}

{% for module in modules %}
/* ============================================================================
 * MODULE: {{ module.name }}
 * ============================================================================ */
{% include "module_content.h.j2" %}

{% endfor %}

{% if renames %}
//===--------------------------------------------------------------------===//
// Renamed constructs
//===--------------------------------------------------------------------===//
//! Former spellings, available only while targeting a version that still had
//! them. Each names the same construct, so an alias costs nothing at runtime.
{% set v = c_opts.version_macro %}
{% for r in renames %}
#if {{ v }}_BELOW({{ r.args }})
//! Renamed to {{ r.new }} in {{ r.version }}.
{% if r.is_type %}
typedef {{ r.new }} {{ r.old }};
{% else %}
#define {{ r.old }} {{ r.new }}
{% endif %}
#endif
{% endfor %}

{% endif %}
{% if c_opts.emit_extension_api %}
//===--------------------------------------------------------------------===//
// DuckDB extension access
//===--------------------------------------------------------------------===//

//! Passed to C API extension as a parameter to the entrypoint.
struct duckdb_extension_access {
	//! Indicate that an error has occurred.
	void (*set_error)(duckdb_extension_info info, const char *error);
	//! Fetch the database on which to register the extension.
	duckdb_database *(*get_database)(duckdb_extension_info info);
	//! Fetch the API struct pointer.
	const void *(*get_api)(duckdb_extension_info info, const char *version);
};
{% endif %}

#ifdef __cplusplus
}
#endif
